{
  "name": "@mjakl/pi-cron",
  "version": "0.1.0",
  "description": "Cron extension for the Pi coding agent: one-shot reminders and recurring jobs that fire into the running session.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "config.ts",
    "controller.ts",
    "cron.ts",
    "lock.ts",
    "messages.ts",
    "render.ts",
    "scheduler.ts",
    "tasks.ts",
    "tools.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "cron",
    "scheduler",
    "reminder",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangvu12/pi-cron.git"
  },
  "bugs": {
    "url": "https://github.com/hoangvu12/pi-cron/issues"
  },
  "homepage": "https://github.com/hoangvu12/pi-cron#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^25.2.3",
    "typebox": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
